---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hola, soy Cesar Gordillo</h1>
				<p class="tagline">Acuarelista y profesor de talleres de pintura</p>
				<p>
					Pinto en acuarela desde hace años, explorando el color, la luz y la
					espontaneidad del agua sobre el papel. A través de mis talleres,
					comparto esta técnica con quienes quieren perder el miedo al pincel
					y descubrir su propia voz creativa &mdash; sin importar su nivel de
					experiencia.
				</p>
				<p>
					Aquí encontrarás una muestra de mi trabajo reciente, próximos talleres
					y algunas reflexiones sobre el proceso de pintar con acuarela.
				</p>
			</section>

			<section class="featured">
				<h2>Trabajos destacados</h2>
				{posts.length > 0 ? (
					<ul class="project-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} />
									)}
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p>Pronto encontrarás aquí mis piezas y proyectos más recientes.</p>
				)}
				<a href="/blog" class="see-all">Ver todo el trabajo &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3rem;
	}
	.tagline {
		font-size: 1.2rem;
		font-style: italic;
		color: rgb(var(--gray-dark));
		margin-top: -0.5rem;
	}
	.project-list {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
	}
	.project-list li img {
		width: 100%;
		border-radius: 8px;
		margin-bottom: 0.5rem;
	}
	.see-all {
		display: inline-block;
		margin-top: 1.5rem;
	}
</style>
