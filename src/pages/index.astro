---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hello, I'm Cesar Gordillo</h1>
				<p class="tagline">Watercolor artist &amp; workshop teacher</p>
				<p>
					I've been painting in watercolor for years, exploring color, light,
					and the spontaneity of water on paper. Through my workshops, I share
					this technique with anyone looking to lose their fear of the brush
					and discover their own creative voice &mdash; no matter their
					experience level.
				</p>
				<p>
					Here you'll find a selection of my recent work, upcoming workshops,
					and a few reflections on the process of painting with watercolor.
				</p>
			</section>

			<section class="featured">
				<h2>Featured Work</h2>
				{posts.length > 0 ? (
					<ul class="project-list">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt={post.data.title} />
									)}
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p>My latest pieces and projects will appear here soon.</p>
				)}
				<a href="/blog" class="see-all">See all work &rarr;</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		margin-bottom: 3rem;
	}
	.tagline {
		font-size: 1.2rem;
		font-style: italic;
		color: rgb(var(--gray-dark));
		margin-top: -0.5rem;
	}
	.project-list {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.5rem;
	}
	.project-list li img {
		width: 100%;
		border-radius: 8px;
		margin-bottom: 0.5rem;
	}
	.see-all {
		display: inline-block;
		margin-top: 1.5rem;
	}
</style>
